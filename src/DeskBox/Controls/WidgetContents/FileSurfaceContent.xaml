<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.FileSurfaceContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:svc="using:DeskBox.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="FileIconLoadingPlaceholderStyle" TargetType="ContentControl">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="36" Height="36">
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Opacity="0.62" />
                            </Grid>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SurfaceGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SurfaceListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SurfaceFileIconTemplate">
            <Grid
                Tag="ItemSlot"
                Width="{Binding DataContext.IconTileWidth, ElementName=ItemsGrid}"
                Height="{Binding DataContext.IconTileHeight, ElementName=ItemsGrid}"
                Margin="{Binding DataContext.IconTileMargin, ElementName=ItemsGrid}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <controls:FileItemSurface
                    Mode="Icon"
                    LayoutContext="{Binding DataContext, ElementName=ItemsGrid}"
                    UseStackChildIndent="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    AllowDrop="True"
                    Loaded="ItemSurface_Loaded"
                    Unloaded="ItemSurface_Unloaded"
                    DragLeave="ItemSurface_DragLeave"
                    DragOver="ItemSurface_DragOver"
                    Drop="ItemSurface_Drop"
                    PointerPressed="ItemSurface_PointerPressed" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SurfaceFileStackIconTemplate">
            <Border
                Tag="StackSurface"
                Width="{Binding TileWidth}"
                Height="{Binding TileHeight}"
                Margin="{Binding TileMargin}"
                Padding="{Binding TilePadding}"
                CornerRadius="8"
                AllowDrop="True"
                Loaded="StackSurface_Loaded"
                DragLeave="StackSurface_DragLeave"
                DragOver="StackSurface_DragOver"
                Drop="StackSurface_Drop"
                PointerEntered="StackSurface_PointerEntered"
                PointerExited="StackSurface_PointerExited"
                PointerPressed="StackSurface_PointerPressed"
                PointerReleased="StackSurface_PointerReleased">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <Grid Width="{Binding PreviewSize}" Height="{Binding PreviewSize}">
                        <Grid Visibility="{Binding CollapsedPreviewVisibility}">
                            <Grid
                                Width="{Binding PreviewItemSize}"
                                Height="{Binding PreviewItemSize}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.72"
                                RenderTransformOrigin="0.5,0.82"
                                Visibility="{Binding ThirdPreviewVisibility}">
                                <Grid.RenderTransform>
                                    <CompositeTransform Rotation="-7" ScaleX="0.70" ScaleY="0.70" TranslateX="-5" TranslateY="3" />
                                </Grid.RenderTransform>
                                <Image Source="{Binding PreviewThree.Icon}" Stretch="Uniform" Visibility="{Binding PreviewThree.IconVisibility}" />
                                <ContentControl Style="{StaticResource FileIconLoadingPlaceholderStyle}" Width="{Binding PreviewItemSize}" Height="{Binding PreviewItemSize}" Visibility="{Binding PreviewThree.FallbackIconVisibility}" />
                            </Grid>
                            <Grid
                                Width="{Binding PreviewItemSize}"
                                Height="{Binding PreviewItemSize}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.88"
                                RenderTransformOrigin="0.5,0.82">
                                <Grid.RenderTransform>
                                    <CompositeTransform Rotation="6" ScaleX="0.80" ScaleY="0.80" TranslateX="5" TranslateY="2" />
                                </Grid.RenderTransform>
                                <Image Source="{Binding PreviewTwo.Icon}" Stretch="Uniform" Visibility="{Binding PreviewTwo.IconVisibility}" />
                                <ContentControl Style="{StaticResource FileIconLoadingPlaceholderStyle}" Width="{Binding PreviewItemSize}" Height="{Binding PreviewItemSize}" Visibility="{Binding PreviewTwo.FallbackIconVisibility}" />
                            </Grid>
                            <Grid
                                Width="{Binding PreviewItemSize}"
                                Height="{Binding PreviewItemSize}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.82">
                                <Grid.RenderTransform>
                                    <CompositeTransform ScaleX="0.90" ScaleY="0.90" TranslateY="-2" />
                                </Grid.RenderTransform>
                                <Image Source="{Binding PreviewOne.Icon}" Stretch="Uniform" Visibility="{Binding PreviewOne.IconVisibility}" />
                                <ContentControl Style="{StaticResource FileIconLoadingPlaceholderStyle}" Width="{Binding PreviewItemSize}" Height="{Binding PreviewItemSize}" Visibility="{Binding PreviewOne.FallbackIconVisibility}" />
                            </Grid>
                            <Border
                                MinWidth="16"
                                Height="16"
                                Padding="3,0"
                                Margin="0,0,1,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{Binding CountText}" />
                            </Border>
                        </Grid>
                        <Button
                            Width="{Binding PreviewItemSize}"
                            Height="{Binding PreviewItemSize}"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderThickness="0"
                            Click="StackCollapseButton_Click"
                            CornerRadius="6"
                            IsTabStop="False"
                            Visibility="{Binding ExpandedAnchorVisibility}">
                            <FontIcon FontSize="12" Glyph="&#xE70E;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        MaxWidth="{Binding LabelMaxWidth}"
                        Margin="2,0"
                        HorizontalAlignment="Center"
                        FontSize="{Binding LabelFontSize}"
                        MaxLines="2"
                        Text="{Binding Name}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SurfaceFileListTemplate">
            <controls:FileItemSurface
                Mode="List"
                LayoutContext="{Binding DataContext, ElementName=ItemsList}"
                UseStackChildIndent="True"
                HorizontalAlignment="Left"
                AllowDrop="True"
                Loaded="ItemSurface_Loaded"
                Unloaded="ItemSurface_Unloaded"
                DragLeave="ItemSurface_DragLeave"
                DragOver="ItemSurface_DragOver"
                Drop="ItemSurface_Drop"
                PointerPressed="ItemSurface_PointerPressed" />
        </DataTemplate>

        <DataTemplate x:Key="SurfaceFileStackListTemplate">
            <Border
                Tag="StackSurface"
                Margin="{Binding ListMargin}"
                Padding="{Binding ListPadding}"
                CornerRadius="8"
                AllowDrop="True"
                Loaded="StackSurface_Loaded"
                DragLeave="StackSurface_DragLeave"
                DragOver="StackSurface_DragOver"
                Drop="StackSurface_Drop"
                PointerEntered="StackSurface_PointerEntered"
                PointerExited="StackSurface_PointerExited"
                PointerPressed="StackSurface_PointerPressed"
                PointerReleased="StackSurface_PointerReleased">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="{Binding ListIconSize}" Height="{Binding ListIconSize}">
                        <Grid Visibility="{Binding CollapsedPreviewVisibility}">
                            <Grid Opacity="0.55" Visibility="{Binding ThirdPreviewVisibility}">
                                <Image Source="{Binding PreviewThree.Icon}" Stretch="Uniform" Visibility="{Binding PreviewThree.IconVisibility}" />
                                <ContentControl Style="{StaticResource FileIconLoadingPlaceholderStyle}" Width="{Binding ListIconSize}" Height="{Binding ListIconSize}" Visibility="{Binding PreviewThree.FallbackIconVisibility}" />
                            </Grid>
                            <Grid Margin="4,2,0,0" Opacity="0.76">
                                <Image Source="{Binding PreviewTwo.Icon}" Stretch="Uniform" Visibility="{Binding PreviewTwo.IconVisibility}" />
                                <ContentControl Style="{StaticResource FileIconLoadingPlaceholderStyle}" Width="{Binding ListIconSize}" Height="{Binding ListIconSize}" Visibility="{Binding PreviewTwo.FallbackIconVisibility}" />
                            </Grid>
                            <Grid Margin="0,0,4,3">
                                <Image Source="{Binding PreviewOne.Icon}" Stretch="Uniform" Visibility="{Binding PreviewOne.IconVisibility}" />
                                <ContentControl Style="{StaticResource FileIconLoadingPlaceholderStyle}" Width="{Binding ListIconSize}" Height="{Binding ListIconSize}" Visibility="{Binding PreviewOne.FallbackIconVisibility}" />
                            </Grid>
                            <Border
                                MinWidth="14"
                                Height="14"
                                Padding="2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="7">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="8"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{Binding CountText}" />
                            </Border>
                        </Grid>
                        <Button
                            Width="{Binding ListIconSize}"
                            Height="{Binding ListIconSize}"
                            Padding="0"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderThickness="0"
                            Click="StackCollapseButton_Click"
                            IsTabStop="False"
                            Visibility="{Binding ExpandedAnchorVisibility}">
                            <FontIcon FontSize="11" Glyph="&#xE70E;" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="{Binding LabelFontSize}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" FontSize="10" Glyph="{Binding ChevronGlyph}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <controls:WidgetItemTemplateSelector
            x:Key="SurfaceIconTemplateSelector"
            ItemTemplate="{StaticResource SurfaceFileIconTemplate}"
            StackTemplate="{StaticResource SurfaceFileStackIconTemplate}" />
        <controls:WidgetItemTemplateSelector
            x:Key="SurfaceListTemplateSelector"
            ItemTemplate="{StaticResource SurfaceFileListTemplate}"
            StackTemplate="{StaticResource SurfaceFileStackListTemplate}" />
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Padding="10,4,8,8"
        AllowDrop="True"
        DragEnter="Root_DragEnter"
        DragOver="Root_DragOver"
        DragLeave="Root_DragLeave"
        Drop="Root_Drop"
        KeyDown="Root_KeyDown">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ImportOperationStates">
                <VisualState x:Name="ImportPreparingState">
                    <VisualState.Setters>
                        <Setter Target="ImportStateIcon.Glyph" Value="&#xE896;" />
                        <Setter Target="ImportCancelButton.IsEnabled" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ImportLoadingState">
                    <VisualState.Setters>
                        <Setter Target="ImportStateIcon.Glyph" Value="&#xE898;" />
                        <Setter Target="ImportCancelButton.IsEnabled" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ImportCancelingState">
                    <VisualState.Setters>
                        <Setter Target="ImportStateIcon.Glyph" Value="&#xE895;" />
                        <Setter Target="ImportCancelButton.IsEnabled" Value="False" />
                        <Setter Target="ImportCancelButton.Visibility" Value="Collapsed" />
                        <Setter Target="ImportCancelProgressRing.IsActive" Value="True" />
                        <Setter Target="ImportCancelProgressRing.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ImportSuccessState">
                    <VisualState.Setters>
                        <Setter Target="ImportStateIcon.Glyph" Value="&#xE73E;" />
                        <Setter Target="ImportCancelButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ImportCanceledState">
                    <VisualState.Setters>
                        <Setter Target="ImportStateIcon.Glyph" Value="&#xE711;" />
                        <Setter Target="ImportCancelButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ImportErrorState">
                    <VisualState.Setters>
                        <Setter Target="ImportStateIcon.Glyph" Value="&#xE783;" />
                        <Setter Target="ImportCancelButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{Binding IsLoading}"
                Visibility="{Binding LoadingVisibility}" />

            <GridView
                x:Name="ItemsGrid"
                Background="Transparent"
                IsItemClickEnabled="True"
                ItemClick="Items_ItemClick"
                ItemsSource="{Binding VisibleItems}"
                CanDragItems="True"
                DragItemsCompleted="Items_DragItemsCompleted"
                DragItemsStarting="Items_DragItemsStarting"
                DragStarting="Items_DragStarting"
                DoubleTapped="Items_DoubleTapped"
                KeyDown="Root_KeyDown"
                PointerPressed="Items_PointerPressed"
                PointerMoved="Items_PointerMoved"
                PointerReleased="Items_PointerReleased"
                PointerCaptureLost="Items_PointerCaptureLost"
                RightTapped="Items_RightTapped"
                SelectionChanged="Items_SelectionChanged"
                IsMultiSelectCheckBoxEnabled="False"
                ItemContainerStyle="{StaticResource SurfaceGridViewItemStyle}"
                ItemTemplateSelector="{StaticResource SurfaceIconTemplateSelector}"
                SelectionMode="Extended"
                Visibility="{Binding IconViewVisibility}">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </GridView.ItemContainerTransitions>
            </GridView>

            <ListView
                x:Name="ItemsList"
                Background="Transparent"
                IsItemClickEnabled="True"
                ItemClick="Items_ItemClick"
                ItemsSource="{Binding VisibleItems}"
                CanDragItems="True"
                DragItemsCompleted="Items_DragItemsCompleted"
                DragItemsStarting="Items_DragItemsStarting"
                DragStarting="Items_DragStarting"
                DoubleTapped="Items_DoubleTapped"
                KeyDown="Root_KeyDown"
                PointerPressed="Items_PointerPressed"
                PointerMoved="Items_PointerMoved"
                PointerReleased="Items_PointerReleased"
                PointerCaptureLost="Items_PointerCaptureLost"
                RightTapped="Items_RightTapped"
                SelectionChanged="Items_SelectionChanged"
                IsMultiSelectCheckBoxEnabled="False"
                ItemContainerStyle="{StaticResource SurfaceListViewItemStyle}"
                ItemTemplateSelector="{StaticResource SurfaceListTemplateSelector}"
                SelectionMode="Extended"
                Visibility="{Binding ListViewVisibility}">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
            </ListView>

            <Canvas
                x:Name="SelectionOverlay"
                Canvas.ZIndex="20"
                Background="Transparent"
                IsHitTestVisible="False">
                <Border
                    x:Name="SelectionRectangle"
                    Width="0"
                    Height="0"
                    BorderThickness="1"
                    CornerRadius="0"
                    Visibility="Collapsed" />
                <Grid
                    x:Name="ReorderInsertionIndicator"
                    Canvas.ZIndex="25"
                    Width="0"
                    Height="0"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                    <Border
                        x:Name="ReorderInsertionGlow"
                        CornerRadius="5"
                        Opacity="0.32">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Offset="0" Color="Transparent" />
                                <GradientStop Offset="0.28" Color="Transparent" />
                                <GradientStop x:Name="ReorderInsertionAccentStop" Offset="0.5" />
                                <GradientStop Offset="0.72" Color="Transparent" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border
                        x:Name="ReorderInsertionLine"
                        Width="2"
                        Height="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="1"
                        Opacity="0.88" />
                </Grid>
            </Canvas>

            <TextBox
                x:Name="ItemRenameTextBox"
                Canvas.ZIndex="30"
                Width="220"
                MaxWidth="280"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource WidgetInlineRenameTextBoxStyle}"
                Visibility="Collapsed"
                KeyDown="ItemRenameTextBox_KeyDown"
                LostFocus="ItemRenameTextBox_LostFocus" />

            <StackPanel
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed"
                x:Name="EmptyState">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="24"
                    Glyph="{Binding EmptyStateGlyph}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Text="{Binding EmptyStateTitle}" />
                <TextBlock
                    MaxWidth="260"
                    HorizontalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    svc:Localized.Key="Widget.Empty.ActionsHint" />
                <Button
                    x:Name="EmptyAddButton"
                    HorizontalAlignment="Center"
                    Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock x:Name="EmptyAddButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border
                x:Name="DropOverlay"
                Margin="3"
                Padding="18"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource WidgetCornerRadiusLarge}"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        x:Name="DropOverlayIcon"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        Glyph="&#xE898;" />
                    <TextBlock
                        x:Name="DropOverlayText"
                        MaxWidth="260"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Hallmark · component: file import progress card · genre: modern-minimal · theme: DeskBox native -->
            <!-- Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 -->
            <Border
                x:Name="ImportProgressCard"
                Canvas.ZIndex="50"
                Margin="0,4,0,0"
                Padding="12,8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                AutomationProperties.LiveSetting="Polite"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0"
                SizeChanged="ImportProgressCard_SizeChanged"
                Visibility="Collapsed">
                <Grid ColumnSpacing="8" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <FontIcon
                        x:Name="ImportStateIcon"
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="15"
                        Glyph="&#xE896;" />
                    <TextBlock
                        x:Name="ImportTitleText"
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="ImportPercentText"
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.78" />
                    <Button
                        x:Name="ImportCancelButton"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="3"
                        Width="44"
                        Height="44"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="ImportCancelButton_Click">
                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                    <ProgressRing
                        x:Name="ImportCancelProgressRing"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="3"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="False"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />

                    <ProgressBar
                        x:Name="ImportProgressBar"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Height="3"
                        IsIndeterminate="True"
                        Maximum="100"
                        Minimum="0" />
                    <TextBlock
                        x:Name="ImportDescriptionText"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>

        <CommandBar
            x:Name="SelectionCommandBar"
            Grid.Row="1"
            Margin="0,6,0,0"
            Padding="2,0"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="True"
            Visibility="Collapsed">
            <AppBarButton x:Name="OpenSelectionButton" Click="OpenSelectionButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CopySelectionButton" Click="CopySelectionButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CutSelectionButton" Click="CutSelectionButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8C6;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteSelectionButton" Click="DeleteSelectionButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="RenameSelectionButton" Click="RenameSelectionButton_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Grid>
</UserControl>

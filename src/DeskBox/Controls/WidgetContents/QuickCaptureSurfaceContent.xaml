<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.QuickCaptureSurfaceContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        Padding="{Binding RootPadding}"
        RowSpacing="{Binding RootRowSpacing}"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="RecordsButton"
                Grid.Column="0"
                MinWidth="0"
                MinHeight="26"
                Padding="6,2"
                AllowDrop="True"
                Click="ViewButton_Click"
                Content="{Binding RecordsTabText}"
                DragOver="QuickCaptureTab_DragOver"
                Drop="QuickCaptureTab_Drop"
                Tag="Records"
                UseSystemFocusVisuals="True" />
            <Button
                x:Name="PinnedButton"
                Grid.Column="1"
                MinWidth="0"
                MinHeight="26"
                Padding="6,2"
                AllowDrop="True"
                Click="ViewButton_Click"
                Content="{Binding PinnedTabText}"
                DragOver="QuickCaptureTab_DragOver"
                Drop="QuickCaptureTab_Drop"
                Tag="Pinned"
                UseSystemFocusVisuals="True"
                Visibility="{Binding PinnedTabVisibility}" />
            <Button
                x:Name="RecentButton"
                Grid.Column="2"
                MinWidth="0"
                MinHeight="26"
                Padding="6,2"
                Click="ViewButton_Click"
                Content="{Binding RecentTabText}"
                Tag="Recent"
                UseSystemFocusVisuals="True"
                Visibility="{Binding RecentTabVisibility}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,5,0,0" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="0"
                MinHeight="{Binding InputHeight}"
                Padding="{Binding InputPadding}"
                FontSize="{Binding TextSize}"
                KeyDown="SearchTextBox_KeyDown"
                PlaceholderText="{Binding SearchPlaceholderText}"
                Style="{StaticResource WidgetSearchTextBoxStyle}"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Width="{Binding InputButtonSize}"
                Height="{Binding InputButtonSize}"
                MinWidth="{Binding InputButtonSize}"
                MinHeight="{Binding InputButtonSize}"
                Click="ClearSearchButton_Click"
                Style="{StaticResource WidgetCompactIconButtonStyle}">
                <FontIcon FontSize="{Binding InputActionIconSize}" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <Grid Grid.Row="2" Margin="0,5,0,5" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputTextBox"
                Grid.Column="0"
                MinHeight="{Binding InputHeight}"
                Padding="{Binding InputPadding}"
                AcceptsReturn="True"
                FontSize="{Binding TextSize}"
                KeyDown="InputTextBox_KeyDown"
                PlaceholderText="{Binding InputPlaceholderText}"
                Style="{StaticResource WidgetBorderlessInputTextBoxStyle}"
                Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                Width="{Binding InputButtonSize}"
                Height="{Binding InputButtonSize}"
                MinWidth="{Binding InputButtonSize}"
                MinHeight="{Binding InputButtonSize}"
                Click="AddButton_Click"
                IsEnabled="{Binding CanAddInput}"
                Style="{StaticResource WidgetCompactIconButtonStyle}">
                <FontIcon FontSize="{Binding InputActionIconSize}" Glyph="&#xE710;" />
            </Button>
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="ItemsList"
                Background="Transparent"
                CanDragItems="True"
                DragItemsCompleted="ItemsList_DragItemsCompleted"
                DragItemsStarting="ItemsList_DragItemsStarting"
                IsItemClickEnabled="True"
                ItemClick="ItemsList_ItemClick"
                ItemsSource="{Binding Items}"
                KeyDown="ItemsList_KeyDown"
                SelectionMode="Extended"
                Visibility="{Binding ListVisibility}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="QuickCaptureSurfaceItemRoot"
                            AllowDrop="True"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="7"
                            DragLeave="QuickCaptureItem_DragLeave"
                            DragOver="QuickCaptureItem_DragOver"
                            Drop="QuickCaptureItem_Drop"
                            PointerPressed="QuickCaptureItem_PointerPressed"
                            PointerReleased="QuickCaptureItem_PointerReleased">
                            <Grid
                                MinHeight="46"
                                Padding="8,6"
                                ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="{Binding TypeIconSize}"
                                    Glyph="{Binding TypeGlyph}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontSize="{Binding TextSize}"
                                        MaxLines="3"
                                        Text="{Binding DisplayText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="{Binding SecondaryTextSize}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding UpdatedAtText}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Width="26"
                                        Height="26"
                                        MinWidth="26"
                                        Padding="0"
                                        AutomationProperties.Name="{Binding PinTooltip}"
                                        Click="PinItemButton_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="{Binding PinTooltip}">
                                        <FontIcon FontSize="{Binding ActionIconSize}" Glyph="{Binding PinGlyph}" />
                                    </Button>
                                    <Button
                                        Width="26"
                                        Height="26"
                                        MinWidth="26"
                                        Padding="0"
                                        Click="CopyItemButton_Click"
                                        Tag="{Binding}">
                                        <FontIcon FontSize="{Binding ActionIconSize}" Glyph="&#xE8C8;" />
                                    </Button>
                                    <Button
                                        Width="26"
                                        Height="26"
                                        MinWidth="26"
                                        Padding="0"
                                        Click="DeleteItemButton_Click"
                                        Tag="{Binding}">
                                        <FontIcon FontSize="{Binding ActionIconSize}" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="7"
                Visibility="{Binding EmptyStateVisibility}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="{Binding EmptyIconSize}"
                    Glyph="&#xE8A5;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{Binding TitleTextSize}"
                    Text="{Binding EmptyStateTitle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{Binding TextSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding EmptyStateText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{Binding IsSwitchingView}"
                Visibility="{Binding ViewSwitchLoadingVisibility}" />
        </Grid>
    </Grid>
</UserControl>

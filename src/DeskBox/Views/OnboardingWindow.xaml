<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5 · macrostructure: Guided workbench · genre: playful · tone: practical and reassuring · palette: existing WinUI resources · slop: pass -->
<Window
    x:Class="DeskBox.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DeskBox Onboarding">

    <Grid
        x:Name="RootGrid"
        MinWidth="660"
        MinHeight="540"
        Padding="40"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

        <Grid.Resources>
            <!-- ── Shared text styles ── -->
            <Style x:Key="StepEyebrowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Style>
            <Style x:Key="StepTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="34"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="StepBodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="LineHeight" Value="21"/>
                <Setter Property="TextWrapping" Value="WrapWholeWords"/>
            </Style>

            <!-- ── Card style ── -->
            <Style x:Key="SettingCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,14"/>
            </Style>

            <!-- ── Feature card style ── -->
            <Style x:Key="FeatureCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18,16"/>
            </Style>

            <!-- ── Value highlight card style ── -->
            <Style x:Key="ValueCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20,18"/>
            </Style>

            <!-- ── Hint row style ── -->
            <Style x:Key="HintIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Lightweight visual guidance: one shared surface, icons inline with actions. -->
            <Style x:Key="VisualStageLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,9"/>
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════════ Title Bar ═════════════ -->
        <Grid x:Name="TitleBarHost" Height="36" Margin="-40,-40,-40,6" Background="Transparent"/>

        <!-- ═════════════ Content Area ═════════════ -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">

            <Grid x:Name="StepContainer" MinHeight="420">

                <!-- Hallmark · Workbench task flow · existing WinUI theme · motion restrained -->
                <StackPanel
                    x:Name="TaskStep1Panel"
                    MaxWidth="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="22"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Width="28" Height="28" Source="ms-appx:///Assets/deskbox.svg"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="DeskBox"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step1.Title"/>
                        <TextBlock
                            MaxWidth="600"
                            HorizontalAlignment="Left"
                            Style="{StaticResource StepBodyText}"
                            svc:Localized.Key="Onboarding.Task.Step1.Body"/>
                    </StackPanel>
                    <Border Style="{StaticResource FeatureCard}" Padding="20,18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Grid Width="48" Height="48" VerticalAlignment="Center">
                                <Border
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="10"
                                    Opacity="0.12"/>
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="21"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B7;"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    svc:Localized.Key="Onboarding.Task.Step1.LocationTitle"/>
                                <TextBlock
                                    Style="{StaticResource StepBodyText}"
                                    svc:Localized.Key="Onboarding.Task.Step1.LocationBody"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="1.08*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource SettingCard}">
                            <StackPanel Spacing="6">
                                <FontIcon
                                    HorizontalAlignment="Left"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE72E;"/>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    svc:Localized.Key="Onboarding.Task.Step1.LocalTitle"/>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    svc:Localized.Key="Onboarding.Task.Step1.LocalBody"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SettingCard}">
                            <StackPanel Spacing="6">
                                <FontIcon
                                    HorizontalAlignment="Left"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE7E8;"/>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    svc:Localized.Key="Onboarding.Task.Step1.ToggleTitle"/>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    svc:Localized.Key="Onboarding.Task.Step1.ToggleBody"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel
                    x:Name="TaskStep2Panel"
                    MaxWidth="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Width="28" Height="28" Source="ms-appx:///Assets/deskbox.svg"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="DeskBox"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step1.Title"/>
                        <TextBlock
                            MaxWidth="610"
                            HorizontalAlignment="Left"
                            Style="{StaticResource StepBodyText}"
                            svc:Localized.Key="Onboarding.Task.Step1.Body"/>
                    </StackPanel>
                    <Border Style="{StaticResource SettingCard}" Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="18">
                            <StackPanel Grid.Column="0" Spacing="7" HorizontalAlignment="Center">
                                <Grid Width="44" Height="44">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10"/>
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Glyph="&#xE7C3;"/>
                                </Grid>
                                <TextBlock
                                    MaxWidth="180"
                                    Style="{StaticResource VisualStageLabel}"
                                    svc:Localized.Key="Onboarding.Scene.DesktopFile"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="23"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="→"/>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    svc:Localized.Key="Common.Move"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="7" HorizontalAlignment="Center">
                                <Grid Width="62" Height="44">
                                    <Border
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="10"
                                        Opacity="0.12"/>
                                    <Grid Margin="10,8" RowDefinitions="Auto,*">
                                        <Border
                                            Width="20"
                                            Height="3"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            CornerRadius="2"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                            <FontIcon FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B7;"/>
                                            <Border Width="17" Height="3" VerticalAlignment="Center" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" CornerRadius="2" Opacity="0.55"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <TextBlock
                                    MaxWidth="180"
                                    Style="{StaticResource VisualStageLabel}"
                                    svc:Localized.Key="Onboarding.Scene.FileWidget"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource FeatureCard}" Padding="18,16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Grid Width="42" Height="42" VerticalAlignment="Center">
                                    <Border
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="9"
                                        Opacity="0.12"/>
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="19"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE8B7;"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        svc:Localized.Key="Onboarding.Task.Step2.PathTitle"/>
                                    <TextBlock
                                        x:Name="TaskStep2StoragePathText"
                                        FontFamily="Consolas"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"/>
                                    <TextBlock
                                        x:Name="TaskStep2PathMetaText"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button
                                    x:Name="TaskStep2ChangePathButton"
                                    Grid.Column="2"
                                    MinHeight="38"
                                    VerticalAlignment="Center"
                                    Click="TaskStep2ChangePath_Click"
                                    svc:Localized.Key="Onboarding.Task.Step2.ChangePath"/>
                            </Grid>
                            <Border
                                x:Name="TaskStep2PathWarningBorder"
                                Padding="12,9"
                                BorderBrush="#66FFB900"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="Collapsed">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#FFFFB900"
                                        Glyph="&#xE7BA;"/>
                                    <TextBlock
                                        x:Name="TaskStep2PathWarningText"
                                        Grid.Column="1"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                svc:Localized.Key="Onboarding.Task.Step1.LocalBody"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="TaskStep3Panel"
                    MaxWidth="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step3.Title"/>
                        <TextBlock
                            MaxWidth="610"
                            HorizontalAlignment="Left"
                            Style="{StaticResource StepBodyText}"
                            svc:Localized.Key="Onboarding.Task.Step3.Body"/>
                    </StackPanel>
                    <Border Style="{StaticResource FeatureCard}" Padding="16,14">
                        <Grid ColumnDefinitions="1.15*,Auto,*,Auto,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="42" Height="42">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Opacity="0.12"/>
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7C1;"/>
                                </Grid>
                                <TextBlock MaxWidth="150" VerticalAlignment="Center" Style="{StaticResource VisualStageLabel}" TextAlignment="Left" svc:Localized.Key="Onboarding.Task.Step3.DragTitle"/>
                            </StackPanel>
                            <FontIcon Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="36" Height="36">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9"/>
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="&#xE77F;"/>
                                </Grid>
                                <TextBlock MaxWidth="145" VerticalAlignment="Center" Style="{StaticResource VisualStageLabel}" TextAlignment="Left" svc:Localized.Key="Onboarding.Task.Step3.PasteTitle"/>
                            </StackPanel>
                            <FontIcon Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="36" Height="36">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9"/>
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="&#xE710;"/>
                                </Grid>
                                <TextBlock MaxWidth="145" VerticalAlignment="Center" Style="{StaticResource VisualStageLabel}" TextAlignment="Left" svc:Localized.Key="Onboarding.Task.Step3.AddTitle"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="TaskStep3TryButton"
                            MinHeight="42"
                            Click="TaskStep3TryWidget_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            svc:Localized.Key="Onboarding.Task.Step3.TryButton"/>
                        <Border Style="{StaticResource StatusBadge}" MaxWidth="430" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <FontIcon
                                    x:Name="TaskStep3StatusIcon"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE946;"/>
                                <TextBlock
                                    x:Name="TaskStep3StatusText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource HintText}"
                                    TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="TaskStep4Panel"
                    MaxWidth="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step4.Title"/>
                        <TextBlock
                            MaxWidth="620"
                            HorizontalAlignment="Left"
                            Style="{StaticResource StepBodyText}"
                            svc:Localized.Key="Onboarding.Task.Step4.Body"/>
                    </StackPanel>
                    <Border Style="{StaticResource SettingCard}" Padding="18,14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="7">
                                <Border Width="66" Height="46" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid Margin="8" RowDefinitions="Auto,*">
                                        <Border Width="22" Height="3" HorizontalAlignment="Left" Background="{ThemeResource TextFillColorSecondaryBrush}" CornerRadius="2"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                            <FontIcon FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B7;"/>
                                            <FontIcon FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B7;"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="↔"/>
                                <Border Grid.Column="2" Width="58" Height="24" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE7E8;"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock FontSize="13" FontWeight="SemiBold" svc:Localized.Key="Onboarding.Task.Step4.ToggleTitle"/>
                                <TextBlock
                                    x:Name="TaskStep4HotkeyText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button
                                x:Name="TaskStep4ToggleButton"
                                Grid.Column="2"
                                MinHeight="40"
                                Click="TaskStep4ToggleWidgets_Click"
                            svc:Localized.Key="Onboarding.Task.Step4.ToggleButton"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Left" MaxWidth="520">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon
                                x:Name="TaskStep4StatusIcon"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE946;"/>
                            <TextBlock x:Name="TaskStep4StatusText" Grid.Column="1" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="TaskStep5Panel"
                    MaxWidth="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Task.Step5.Title"/>
                        <TextBlock
                            MaxWidth="600"
                            HorizontalAlignment="Left"
                            Style="{StaticResource StepBodyText}"
                            svc:Localized.Key="Onboarding.Task.Step5.Body"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <Button MinHeight="50" Padding="14,9" HorizontalContentAlignment="Stretch" Click="TaskStep5OrganizeDesktop_Click">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Grid Width="34" Height="34">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Opacity="0.12"/>
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B7;"/>
                                </Grid>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap" svc:Localized.Key="Onboarding.Task.Step5.Organize"/>
                                <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;"/>
                            </Grid>
                        </Button>
                        <Button MinHeight="50" Padding="14,9" HorizontalContentAlignment="Stretch" Click="TaskStep5OpenAppearance_Click">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Grid Width="34" Height="34">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"/>
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="&#xE790;"/>
                                </Grid>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap" svc:Localized.Key="Onboarding.Task.Step5.Appearance"/>
                                <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;"/>
                            </Grid>
                        </Button>
                        <Button MinHeight="50" Padding="14,9" HorizontalContentAlignment="Stretch" Click="TaskStep5OpenSettings_Click">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Grid Width="34" Height="34">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"/>
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="&#xE713;"/>
                                </Grid>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap" svc:Localized.Key="Onboarding.Task.Step5.Settings"/>
                                <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- ─────────── Step 1: Core Value Overview (3 highlight cards) ─────────── -->
                <StackPanel
                    x:Name="Step1Panel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24"
                    MaxWidth="620">

                    <!-- Brand logo -->
                    <Grid
                        x:Name="BrandLogoHost"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Center"
                        Opacity="1">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,36,36"/>
                        </Grid.Clip>
                        <Image
                            x:Name="BrandLogo"
                            Width="36"
                            Height="36"
                            Source="ms-appx:///Assets/deskbox.svg"/>
                        <Border
                            x:Name="BrandLogoShine"
                            Width="14"
                            Height="54"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Opacity="0.36"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00FFFFFF"/>
                                    <GradientStop Offset="0.5" Color="#A6FFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <CompositeTransform
                                    x:Name="BrandLogoShineTransform"
                                    Rotation="-18"
                                    TranslateX="-44"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Title area -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="Step1Eyebrow"
                            Style="{StaticResource StepEyebrowText}"
                            HorizontalAlignment="Center"
                            svc:Localized.Key="Onboarding.Step1.Eyebrow"/>
                        <TextBlock
                            x:Name="Step1Title"
                            Style="{StaticResource StepTitleText}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            svc:Localized.Key="Onboarding.Step1.Title"/>
                        <TextBlock
                            x:Name="Step1Body"
                            Style="{StaticResource StepBodyText}"
                            HorizontalAlignment="Center"
                            MaxWidth="460"
                            TextAlignment="Center"
                            svc:Localized.Key="Onboarding.Step1.Body"/>
                    </StackPanel>

                    <!-- 3 Value highlight cards -->
                    <StackPanel x:Name="Step1ValueCards" Spacing="10" HorizontalAlignment="Center" MaxWidth="520">
                        <Border x:Name="Step1Card1" Style="{StaticResource ValueCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.12" VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE8B7;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step1.Value1Title"/>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step1.Value1Body"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="Step1Card2" Style="{StaticResource ValueCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.12" VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE721;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step1.Value2Title"/>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step1.Value2Body"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="Step1Card3" Style="{StaticResource ValueCard}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.12" VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE71D;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step1.Value3Title"/>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step1.Value3Body"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Single hint -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" Style="{StaticResource HintIcon}"/>
                        <TextBlock Style="{StaticResource HintText}" svc:Localized.Key="Onboarding.Step1.Hint1"/>
                    </StackPanel>
                </StackPanel>

                <!-- ─────────── Step 2: Create file widgets from the tray ─────────── -->
                <StackPanel
                    x:Name="Step2Panel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20"
                    MaxWidth="620">

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource StepEyebrowText}" HorizontalAlignment="Center" svc:Localized.Key="Onboarding.Step2.Eyebrow"/>
                        <TextBlock Style="{StaticResource StepTitleText}" HorizontalAlignment="Center" TextAlignment="Center" svc:Localized.Key="Onboarding.Step2.Title"/>
                        <TextBlock Style="{StaticResource StepBodyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="480" svc:Localized.Key="Onboarding.Step2.Body"/>
                    </StackPanel>

                    <StackPanel Width="560" MaxWidth="560" Spacing="10">
                        <Border Style="{StaticResource FeatureCard}" Padding="20,18">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Grid Width="42" Height="42" VerticalAlignment="Center">
                                    <Border CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.14"/>
                                    <Image Width="24" Height="24" Source="ms-appx:///Assets/deskbox.svg" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step2.TrayActionTitle"/>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step2.TrayActionBody"/>
                                </StackPanel>
                                <Border Grid.Column="2" Padding="11,6" CornerRadius="6" Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step2.RightClick"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource SettingCard}" Padding="14,12">
                                <StackPanel Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step2.NewWidgetTitle"/>
                                    <TextBlock FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step2.NewWidgetBody"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingCard}" Padding="14,12">
                                <StackPanel Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step2.ConnectFolderTitle"/>
                                    <TextBlock FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step2.ConnectFolderBody"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Hint -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" Style="{StaticResource HintIcon}"/>
                        <TextBlock Style="{StaticResource HintText}" svc:Localized.Key="Onboarding.Step2.FeatureHint"/>
                    </StackPanel>
                </StackPanel>

                <!-- ─────────── Step 3: Appearance (controls + live preview + capsule) ─────────── -->
                <Grid
                    x:Name="Step3Panel"
                    Visibility="Collapsed"
                    ColumnSpacing="32"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left: title + controls -->
                    <StackPanel Grid.Column="0" Spacing="18" MaxWidth="420">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource StepEyebrowText}" svc:Localized.Key="Onboarding.Step3.Eyebrow"/>
                            <TextBlock Style="{StaticResource StepTitleText}" svc:Localized.Key="Onboarding.Step3.Title"/>
                            <TextBlock Style="{StaticResource StepBodyText}" svc:Localized.Key="Onboarding.Step3.Body"/>
                        </StackPanel>

                        <!-- Theme selector -->
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Onboarding.Step3.ThemeSection"/>
                            <StackPanel x:Name="Step3ThemeSelector" Orientation="Horizontal" Spacing="6"/>
                        </StackPanel>

                        <!-- Accent color selector -->
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Onboarding.Step3.AccentSection"/>
                            <StackPanel x:Name="Step3AccentSelector" Orientation="Horizontal" Spacing="6"/>
                        </StackPanel>

                        <!-- Material selector -->
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Onboarding.Step3.MaterialSection"/>
                            <StackPanel x:Name="Step3MaterialSelector" Orientation="Horizontal" Spacing="6"/>
                        </StackPanel>

                        <!-- Capsule mode toggle -->
                        <Border Style="{StaticResource SettingCard}" Padding="14,12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step3.CapsuleTitle"/>
                                    </StackPanel>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step3.CapsuleDescription"/>
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="Step3CapsuleToggle"
                                    Grid.Column="1"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    Toggled="Step3CapsuleToggle_Toggled"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right: live preview widget -->
                    <Border
                        x:Name="Step3PreviewHost"
                        Grid.Column="1"
                        Width="220"
                        Height="200"
                        CornerRadius="10"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="0"
                        VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush x:Name="Step3PreviewBackground" Color="{ThemeResource SystemFillColorSolidNeutralBackground}"/>
                        </Border.Background>
                        <Grid>
                            <!-- Title bar -->
                            <Grid Height="32" VerticalAlignment="Top" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0">
                                    <Border x:Name="Step3PreviewIcon" Width="14" Height="14" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock x:Name="Step3PreviewTitle" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="My Files"/>
                                </StackPanel>
                            </Grid>
                            <!-- File list -->
                            <StackPanel Margin="10,38,10,10" Spacing="6">
                                <Border x:Name="Step3PreviewItem1" Padding="8,5" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.85">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="10" Foreground="White"/>
                                        <TextBlock FontSize="10" Foreground="White" Text="Document.docx"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,5" CornerRadius="4" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Image.png"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,5" CornerRadius="4" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71B;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Link (shortcut)"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ─────────── Step 4: Daily Use (hotkey + startup + storage) ─────────── -->
                <StackPanel
                    x:Name="Step4Panel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18"
                    MaxWidth="560">

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource StepEyebrowText}" HorizontalAlignment="Center" svc:Localized.Key="Onboarding.Step4.Eyebrow"/>
                        <TextBlock Style="{StaticResource StepTitleText}" HorizontalAlignment="Center" TextAlignment="Center" svc:Localized.Key="Onboarding.Step4.Title"/>
                        <TextBlock Style="{StaticResource StepBodyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" svc:Localized.Key="Onboarding.Step4.Body"/>
                    </StackPanel>

                    <!-- Keycap visualization -->
                    <Grid x:Name="Step4KeycapHost" HorizontalAlignment="Center" Margin="0,2,0,6">
                        <Border
                            x:Name="Step4Keycap"
                            MinWidth="88"
                            Height="52"
                            Padding="16,0"
                            CornerRadius="8"
                            BorderThickness="1.5"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <FontIcon x:Name="Step4KeycapIcon" Glyph="&#xE765;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="Step4KeycapText" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Text="F7"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Show/Hide hotkey card -->
                    <Border Style="{StaticResource SettingCard}" MaxWidth="500">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step4.HotkeyTitle"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step4.HotkeyDescription"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
                                <Button
                                    x:Name="Step4HotkeyChangeButton"
                                    MinWidth="72"
                                    Height="32"
                                    Padding="10,0"
                                    Click="Step4HotkeyChange_Click"
                                    FontSize="12"/>
                                <ToggleSwitch
                                    x:Name="Step4HotkeyToggle"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    Toggled="Step4HotkeyToggle_Toggled"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Search hotkey card -->
                    <Border Style="{StaticResource SettingCard}" MaxWidth="500">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step4.SearchHotkeyTitle"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step4.SearchHotkeyDescription"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="Step4SearchHotkeyText"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    VerticalAlignment="Center"
                                    Text="Alt+D"/>
                                <ToggleSwitch
                                    x:Name="Step4SearchHotkeyToggle"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    Toggled="Step4SearchHotkeyToggle_Toggled"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Startup toggle card -->
                    <Border Style="{StaticResource SettingCard}" MaxWidth="500">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step4.StartupTitle"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step4.StartupDescription"/>
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="Step4StartupToggle"
                                Grid.Column="1"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                Toggled="Step4StartupToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Storage path (secondary) -->
                    <Border Style="{StaticResource SettingCard}" MaxWidth="500" Padding="14,12">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" svc:Localized.Key="Onboarding.Step4.StorageTitle"/>
                                    <TextBlock
                                        x:Name="Step4PathText"
                                        FontSize="11.5"
                                        FontFamily="Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button
                                    x:Name="Step4ChangePathButton"
                                    Grid.Column="2"
                                    MinWidth="72"
                                    Height="28"
                                    Padding="8,0"
                                    FontSize="11.5"
                                    Click="Step4ChangePath_Click"
                                    svc:Localized.Key="Onboarding.Storage.ChangePath"/>
                            </Grid>
                            <TextBlock FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Onboarding.Step4.StorageBody"/>
                            <!-- Pin to Quick Access -->
                            <Grid ColumnSpacing="10" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" svc:Localized.Key="Onboarding.Step4.PinTitle"/>
                                <ToggleSwitch
                                    x:Name="Step4PinToggle"
                                    Grid.Column="1"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    Toggled="Step4PinToggle_Toggled"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─────────── Desktop organization: one safe hand-off ─────────── -->
                <StackPanel
                    x:Name="StepOrganizationPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18"
                    MaxWidth="600">

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource StepEyebrowText}" HorizontalAlignment="Center" svc:Localized.Key="Onboarding.Organization.Eyebrow"/>
                        <TextBlock Style="{StaticResource StepTitleText}" HorizontalAlignment="Center" TextAlignment="Center" svc:Localized.Key="Onboarding.Organization.Title"/>
                        <TextBlock Style="{StaticResource StepBodyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520" svc:Localized.Key="Onboarding.Organization.Body"/>
                    </StackPanel>

                    <Border Style="{StaticResource SettingCard}" MaxWidth="560" Padding="16,14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <FontIcon
                                    Glyph="&#xE8B7;"
                                    FontSize="17"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" svc:Localized.Key="Onboarding.Organization.PathTitle"/>
                                    <TextBlock
                                        x:Name="OrganizationPathText"
                                        FontFamily="Consolas"
                                        FontSize="11.5"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="OrganizationChangePath_Click"
                                    svc:Localized.Key="Common.Change"/>
                            </Grid>
                            <TextBlock
                                FontSize="11.5"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                svc:Localized.Key="Onboarding.Organization.MoveNotice"/>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        svc:Localized.Key="Onboarding.Organization.Optional"/>
                </StackPanel>

                <!-- ─────────── Step 5: Ready (summary + try-it animation) ─────────── -->
                <StackPanel
                    x:Name="Step5Panel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20"
                    MaxWidth="580">

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource StepEyebrowText}" HorizontalAlignment="Center" svc:Localized.Key="Onboarding.Step5.Eyebrow"/>
                        <TextBlock Style="{StaticResource StepTitleText}" HorizontalAlignment="Center" TextAlignment="Center" svc:Localized.Key="Onboarding.Step5.Title"/>
                        <TextBlock Style="{StaticResource StepBodyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" svc:Localized.Key="Onboarding.Step5.Body"/>
                    </StackPanel>

                    <!-- Summary cards -->
                    <Grid x:Name="Step5SummaryGrid" ColumnSpacing="10" RowSpacing="10" MaxWidth="520" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingCard}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Onboarding.Step5.SummaryWidgets"/>
                                </StackPanel>
                                <TextBlock x:Name="Step5WidgetsSummary" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingCard}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Onboarding.Step5.SummaryAppearance"/>
                                </StackPanel>
                                <TextBlock x:Name="Step5AppearanceSummary" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingCard}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE765;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Onboarding.Step5.SummaryDaily"/>
                                </StackPanel>
                                <TextBlock x:Name="Step5DailySummary" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingCard}" Padding="14,10">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Onboarding.Step5.SummaryStorage"/>
                                </StackPanel>
                                <TextBlock x:Name="Step5StorageSummary" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Try-it search animation -->
                    <Border x:Name="Step5SearchDemo" Style="{StaticResource SettingCard}" MaxWidth="420" Padding="16,14">
                        <StackPanel Spacing="10">
                            <!-- Simulated search box -->
                            <Border
                                x:Name="Step5SearchBox"
                                Height="36"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock
                                        x:Name="Step5SearchDemoText"
                                        Grid.Column="1"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Simulated results -->
                            <StackPanel x:Name="Step5SearchResults" Spacing="6" Opacity="0">
                                <Border Padding="10,7" CornerRadius="6" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="周报.docx"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="10,7" CornerRadius="6" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="周报模板.xlsx"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" svc:Localized.Key="Onboarding.Step5.TrySearchHint"/>
                        </StackPanel>
                    </Border>

                    <!-- Hints -->
                    <StackPanel Spacing="6" MaxWidth="500">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" Style="{StaticResource HintIcon}"/>
                            <TextBlock Style="{StaticResource HintText}" svc:Localized.Key="Onboarding.Step5.Hint1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" Style="{StaticResource HintIcon}"/>
                            <TextBlock Style="{StaticResource HintText}" svc:Localized.Key="Onboarding.Step5.Hint2"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ═════════════ Footer Navigation ═════════════ -->
        <Grid
            x:Name="FooterNav"
            Grid.Row="2"
            Opacity="1"
            Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="ProgressDots"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"/>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="SkipButton"
                    MinWidth="88"
                    Click="SkipButton_Click"
                    svc:Localized.Key="Onboarding.Skip"/>
                <Button
                    x:Name="BackButton"
                    MinWidth="88"
                    Click="BackButton_Click"
                    svc:Localized.Key="Onboarding.Back"/>
                <Button
                    x:Name="NextButton"
                    MinWidth="96"
                    Click="NextButton_Click"
                    Style="{ThemeResource AccentButtonStyle}"
                    svc:Localized.Key="Onboarding.Next"/>
            </StackPanel>
        </Grid>

        <!-- ═════════════ Intro Overlay ═════════════ -->
        <Grid
            x:Name="IntroOverlay"
            Grid.RowSpan="3"
            Margin="-40"
            Padding="40"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            IsHitTestVisible="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <Canvas
                    x:Name="IntroMarkHost"
                    Width="170"
                    Height="170"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5"/>
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="IntroTitleText"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextAlignment="Center"
                        svc:Localized.Key="Onboarding.Intro.Title"/>
                    <TextBlock
                        x:Name="IntroBodyText"
                        Width="420"
                        FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="24"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords"
                        svc:Localized.Key="Onboarding.Intro.Body"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.GlanceWidgetSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <StackPanel Spacing="4">
            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Glance.Display.Description"
                svc:Localized.HeaderKey="Glance.Display.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE890;" />
                </toolkit:SettingsCard.HeaderIcon>
                <DropDownButton
                    x:Name="DisplayContentDropDownButton"
                    MinWidth="220"
                    MaxWidth="280"
                    HorizontalAlignment="Right"
                    Click="DisplayContentDropDown_Click" />
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                svc:Localized.DescriptionKey="Glance.LayoutGroup.Description"
                svc:Localized.HeaderKey="Glance.LayoutGroup.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Layout.Title">
                        <ComboBox x:Name="LayoutComboBox" MinWidth="190" DisplayMemberPath="Label" SelectionChanged="LayoutComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="TraditionalCalendarCard"
                        HorizontalContentAlignment="Right"
                        Visibility="Collapsed"
                        svc:Localized.DescriptionKey="Glance.TraditionalCalendar.Description"
                        svc:Localized.HeaderKey="Glance.TraditionalCalendar.Title">
                        <ComboBox
                            x:Name="TraditionalCalendarComboBox"
                            MinWidth="220"
                            DisplayMemberPath="Label"
                            SelectionChanged="TraditionalCalendarComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="CalendarMaterialCard"
                        HorizontalContentAlignment="Right"
                        Visibility="Collapsed"
                        svc:Localized.DescriptionKey="Glance.CalendarMaterial.Description"
                        svc:Localized.HeaderKey="Glance.CalendarMaterial.Title">
                        <ComboBox
                            x:Name="CalendarMaterialComboBox"
                            MinWidth="190"
                            DisplayMemberPath="Label"
                            SelectionChanged="CalendarMaterialComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="CalendarImageTransparencyCard"
                        HorizontalContentAlignment="Right"
                        Visibility="Collapsed"
                        svc:Localized.DescriptionKey="Glance.CalendarMaterial.TransparencyDescription"
                        svc:Localized.HeaderKey="Glance.CalendarMaterial.Transparency">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="CalendarImageTransparencyValue"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingValueTextStyle}" />
                            <Slider
                                x:Name="CalendarImageTransparencySlider"
                                Width="190"
                                Minimum="0"
                                Maximum="1"
                                StepFrequency="0.02"
                                ValueChanged="CalendarImageTransparencySlider_ValueChanged" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Typography.Font">
                        <ComboBox x:Name="FontComboBox" MinWidth="220" MaxDropDownHeight="360" DisplayMemberPath="Label" SelectionChanged="FontComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Typography.Title">
                        <Slider x:Name="TimeScaleSlider" Width="190" Minimum="0.75" Maximum="1.35" StepFrequency="0.05" ValueChanged="TimeScaleSlider_ValueChanged" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                svc:Localized.DescriptionKey="Glance.BackgroundGroup.Description"
                svc:Localized.HeaderKey="Glance.Background.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Background.Title">
                        <ComboBox x:Name="BackgroundSourceComboBox" MinWidth="190" DisplayMemberPath="Label" SelectionChanged="BackgroundSourceComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="OnlineImageCategoryCard"
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Glance.Background.Category.Description"
                        svc:Localized.HeaderKey="Glance.Background.Category.Title">
                        <ComboBox
                            x:Name="OnlineImageCategoryComboBox"
                            MinWidth="190"
                            DisplayMemberPath="Label"
                            SelectionChanged="OnlineImageCategoryComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Name="LocalSourceCard" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" svc:Localized.HeaderKey="Glance.Background.Files">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="LocalSourceSummary"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingDescriptionTextStyle}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button x:Name="ChooseFilesButton" Click="ChooseFilesButton_Click" svc:Localized.Key="Glance.Background.ChooseFiles" />
                                <Button x:Name="ChooseFolderButton" Click="ChooseFolderButton_Click" svc:Localized.Key="Glance.Background.ChooseFolder" />
                                <Button x:Name="ClearLocalSourceButton" Click="ClearLocalSourceButton_Click" svc:Localized.Key="Glance.Background.ClearSelection" />
                            </StackPanel>
                        </Grid>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Rotation.Title">
                        <ComboBox x:Name="RotationComboBox" MinWidth="190" DisplayMemberPath="Label" SelectionChanged="RotationComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Rotation.Random">
                        <ToggleSwitch x:Name="RandomOrderToggle" MinWidth="0" OffContent="" OnContent="" Toggled="RandomOrderToggle_Toggled" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Cache.Title">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="CacheSizeText" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" />
                            <Button Click="ClearCacheButton_Click" svc:Localized.Key="Glance.Cache.Clear" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsExpander
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                svc:Localized.DescriptionKey="Glance.AppearanceGroup.Description"
                svc:Localized.HeaderKey="Glance.AppearanceGroup.Title">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Transition.Title">
                        <ComboBox x:Name="TransitionComboBox" MinWidth="190" DisplayMemberPath="Label" SelectionChanged="TransitionComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Speed.Standard">
                        <ComboBox x:Name="SpeedComboBox" MinWidth="190" DisplayMemberPath="Label" SelectionChanged="SpeedComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.HeaderKey="Glance.Readability.Title">
                        <ComboBox x:Name="ReadabilityComboBox" MinWidth="190" DisplayMemberPath="Label" SelectionChanged="ReadabilityComboBox_SelectionChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        HorizontalContentAlignment="Right"
                        svc:Localized.DescriptionKey="Glance.PhotoControls.Description"
                        svc:Localized.HeaderKey="Glance.PhotoControls.Title">
                        <ToggleSwitch
                            x:Name="ShowPhotoControlsToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="ShowPhotoControlsToggle_Toggled" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </StackPanel>
</UserControl>
